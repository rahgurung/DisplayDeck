<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Release builds use the hardened runtime, which blocks location access unless the app declares it. DisplayDeck asks
     for the location only to work out sunrise and sunset for schedules. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.personal-information.location</key><true/>
</dict>
</plist>
